{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://v5-api.blockchainunn.org/api/:path*" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/community", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/submit-project", "destination": "/index.html" },
    { "source": "/admin/export", "destination": "/index.html" }
  ]
}
