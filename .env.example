# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://blockathon_app:change-me@127.0.0.1:5432/blockathonv5
# Number of pooled connections per serverless instance.
DATABASE_POOL_MAX=3
# Browser origins allowed to call the API directly.
ALLOWED_ORIGINS=https://www.blockchainunn.org,https://blockchainunn.org
# Required for /api/export. Generate with: openssl rand -hex 32
FORM_EXPORT_KEY=
# Optional registration confirmation email (Resend).
RESEND_API_KEY=
CONFERENCE_FROM_EMAIL=
# Optional salt used to hash client IPs. Leave empty to skip storing them.
IP_HASH_SALT=
