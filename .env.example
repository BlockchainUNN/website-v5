# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://blockathon_app:change-me@127.0.0.1:5432/blockathonv5
# Number of pooled connections per serverless instance.
DATABASE_POOL_MAX=3
# Browser origins allowed to call the API directly.
ALLOWED_ORIGINS=https://www.blockchainunn.org,https://blockchainunn.org
# Required for /api/export. Generate with: openssl rand -hex 32
FORM_EXPORT_KEY=
# Optional salt used to hash client IPs. Leave empty to skip storing them.
IP_HASH_SALT=
# Transactional email. Brevo is preferred when a key is present; Gmail SMTP is the fallback.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=team@blockchainunn.org
BREVO_SENDER_NAME="The BlockchainUNN Team"
GMAIL_SENDER_MAIL=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=team@blockchainunn.org
MAIL_FROM=team@blockchainunn.org
MAIL_FROM_NAME="The BlockchainUNN Team"
# Kept for compatibility with the v3 backend naming.
FROM_MAIL=team@blockchainunn.org
